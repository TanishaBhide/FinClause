# Copy to .env (or set as real environment variables). Never commit .env.
#
# Only needed if Tesseract is installed somewhere non-standard and is not on PATH.
# The pipeline already checks PATH and the standard install folders automatically.
# FINCLAUSE_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#
# Note: the package reads this from the process environment; it does not load .env files itself.
# PowerShell (current session):  $env:FINCLAUSE_TESSERACT_CMD = "C:\Program Files\Tesseract-OCR\tesseract.exe"
# PowerShell (permanent):        setx FINCLAUSE_TESSERACT_CMD "C:\Program Files\Tesseract-OCR\tesseract.exe"
